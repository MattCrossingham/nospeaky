# Copy onto the VPS as /opt/nospeaky/.env — never commit real keys.
NOSPEAKY_API_KEY=
NOSPEAKY_ALLOW_URL_FETCH=1
NOSPEAKY_MODEL=Systran/faster-whisper-tiny
NOSPEAKY_BACKEND=faster
NOSPEAKY_MAX_DURATION_SEC=600
NOSPEAKY_JOB_LIMIT_PER_HOUR=8
NOSPEAKY_STREAM_LIMIT_PER_HOUR=8

# Optional: Langbly for Read-it-in (caption text only). Empty = Argos fallback.
LANGBLY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
NOSPEAKY_PRO_MAX_DURATION_SEC=3600
NOSPEAKY_PRO_MAX_CONCURRENT=4

# Stripe — real keys on the box only (/opt/nospeaky/data/stripe.env)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_MODE=test
